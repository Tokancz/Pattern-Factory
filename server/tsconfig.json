{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "./dist",
    "rootDir": ".",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    },

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}